<Window x:Class="PromptLibrary.App.Views.TeamNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Note for everyone"
        AutomationProperties.Name="Note for everyone"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- A multi-line box with a character count; Save note, Remove note (only while a note exists) and Cancel. -->
    <StackPanel Margin="16">
        <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NoteBox" Style="{StaticResource {x:Type TextBox}}" Height="96" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 MaxLength="{Binding MaxLength}"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Note for everyone"
                 AutomationProperties.HelpText="Everyone using the team library sees this note under the Team header" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Text="{Binding CountText}"
                   HorizontalAlignment="Right" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="Everyone sees this under the Team header until they hide it." />

        <Grid Margin="0,24,0,0">
            <Button Content="Remove note" HorizontalAlignment="Left" Click="Remove_Click"
                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Remove note" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save note"
                        IsEnabled="{Binding CanSave}" Click="Save_Click" AutomationProperties.Name="Save note" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
