<Window x:Class="PromptLibrary.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PromptLibrary.App.Views"
        Style="{StaticResource AppWindow}"
        Title="Welcome to Prompt Library"
        AutomationProperties.Name="Welcome to Prompt Library"
        Icon="/Assets/app.ico"
        Width="640" Height="480"
        ResizeMode="NoResize">
    <!-- Five steps in one window; only the current step's panel is visible. Enter = Next/Finish, Esc or × = skip
         (after step 1 it asks first once a backup folder has been chosen). -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="544" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="32,32,32,16">

                <!-- Step 1: Welcome -->
                <StackPanel Style="{StaticResource StepPanel}"
                            Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="/Assets/app-icon.png" Width="96" Height="96" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Prompt Library icon" />
                    <TextBlock Text="Your prompts, one shortcut away." Style="{StaticResource Heading}" Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="Prompt Library keeps all your AI prompts in one place. Press a shortcut in any app, pick a prompt, and it's pasted right where you were typing." />
                </StackPanel>

                <!-- Step 2: Shortcut (or, if another app has it, a capture box that is already listening) -->
                <StackPanel Style="{StaticResource StepPanel}"
                            Visibility="{Binding IsShortcut, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ShortcutHeading}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding ShortcutBody}" Style="{StaticResource Body}" />

                    <ItemsControl ItemsSource="{Binding Keycaps}" Margin="0,24,0,0" Focusable="False"
                                  AutomationProperties.Name="{Binding KeycapsName}"
                                  Visibility="{Binding ShowKeycaps, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="56" Height="48" Margin="0,0,8,0" Padding="16,0"
                                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1,1,1,3" CornerRadius="{StaticResource Radius}">
                                    <TextBlock Text="{Binding}" FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,24,0,0" Visibility="{Binding ShortcutTried, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" Data="M1.5,8.5 L6,13 L14.5,3.5"
                              Stroke="{DynamicResource Brush.Brand}" StrokeThickness="2" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite"
                                   Text="That's it. In any other app, this opens your prompt menu — pick a prompt and it's pasted where you were typing." />
                    </Grid>


                    <StackPanel Margin="0,24,0,0"
                                Visibility="{Binding ShowCaptureBox, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="New shortcut" Style="{StaticResource FieldLabel}" />
                        <views:ShortcutBox x:Name="ShortcutField" Style="{StaticResource {x:Type TextBox}}" Width="280"
                                           Shortcut="{Binding CaptureBoxText, Mode=OneWay}"
                                           HorizontalAlignment="Left"
                                           AutomationProperties.Name="New shortcut"
                                           AutomationProperties.HelpText="Press the new shortcut, or Esc to cancel" />
                        <TextBlock x:Name="ShortcutStatus" Text="{Binding ShortcutStatus}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShortcutStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Style="{StaticResource LinkButton}" Content="Change shortcut" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Command="{Binding ChangeShortcutCommand}"
                            AutomationProperties.Name="Change shortcut"
                            Visibility="{Binding ShowChangeLink, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Step 3: Team (optional; Next skips) -->
                <StackPanel Style="{StaticResource StepPanel}"
                            Visibility="{Binding IsTeam, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Does your team share prompts?" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="Connect to your team's shared prompts, or start a library for your team." />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0"
                                Visibility="{Binding Team.ShowActions, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Join a team library" Click="JoinTeam_Click"
                                AutomationProperties.Name="Join a team library" />
                        <Button Content="Start a team library" Margin="8,0,0,0" Click="StartTeam_Click"
                                AutomationProperties.Name="Start a team library" />
                    </StackPanel>
                    <StackPanel Margin="0,24,0,0"
                                Visibility="{Binding Team.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" Data="M1.5,8.5 L6,13 L14.5,3.5"
                                  Stroke="{DynamicResource Brush.Brand}" StrokeThickness="2" />
                            <TextBlock Text="{Binding Team.ConnectedLine}" Style="{StaticResource Body}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Step 4: Backups -->
                <StackPanel Style="{StaticResource StepPanel}"
                            Visibility="{Binding IsBackups, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Keep a copy in the cloud" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16"
                               Text="If this PC breaks, your prompts are safe. Prompt Library saves a copy here once a day." />
                    <views:BackupLocationPicker x:Name="Picker" SelectsWithoutBackingUp="True" />
                    <!-- Esc or × while the backup runs: leaving waits for it, and says so. -->
                    <TextBlock Text="Finishing the backup… one moment." Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding ShowFinishingBackup, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Step 5: Ready -->
                <StackPanel Style="{StaticResource StepPanel}"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="You're all set" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding ReadyText}" Style="{StaticResource Body}" />

                    <Border Margin="0,16,0,0" Padding="16,12" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}">
                        <StackPanel>
                            <TextBlock Text="{Binding ShortcutSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BackupSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,24,0,0" FontWeight="SemiBold"
                               Text="Start Prompt Library when Windows starts?" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Recommended. The shortcut only works while Prompt Library is running. You can change this later in Settings." />
                    <CheckBox IsChecked="{Binding StartWithWindows}"
                              Content="Yes, start it with Windows"
                              AutomationProperties.Name="Start Prompt Library when Windows starts"
                              AutomationProperties.HelpText="Recommended. The shortcut only works while Prompt Library is running." />
                    <CheckBox Margin="0,8,0,0" IsChecked="{Binding PasteAfterCopy}"
                              Content="Paste into the app I was using"
                              AutomationProperties.Name="Paste into the app I was using"
                              AutomationProperties.HelpText="After you pick a prompt from the shortcut menu, it's pasted where you were typing. Turn off to only copy." />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                               Text="After you pick a prompt from the shortcut menu, it's pasted where you were typing. Turn off to only copy." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer: one quiet link on the left (steps 1 and 4 only), then the step count, Back and Next/Finish. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LinkButton}" Content="Skip setup" VerticalAlignment="Center"
                        Command="{Binding SkipSetupCommand}" AutomationProperties.Name="Skip setup"
                        Visibility="{Binding ShowSkipSetup, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource LinkButton}" Content="Skip backups for now" VerticalAlignment="Center"
                        Command="{Binding SkipBackupsCommand}" AutomationProperties.Name="Skip backups for now"
                        Visibility="{Binding ShowSkipBackups, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="2" Text="{Binding StepText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="3" Content="Back" Margin="0,0,8,0" Command="{Binding BackCommand}"
                        AutomationProperties.Name="Back"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="PrimaryButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Content="{Binding PrimaryText}" Command="{Binding NextCommand}"
                        AutomationProperties.Name="{Binding PrimaryText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
