<Window x:Class="PromptLibrary.App.Views.MoveCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:PromptLibrary.App.Views.Controls"
        Style="{StaticResource AppDialog}"
        Title="Delete category"
        AutomationProperties.Name="Delete category"
        Icon="/Assets/app.ico"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,16" />

        <!-- Two plain choices: move the prompts (the category to move them to right under it), or delete them too. -->
        <StackPanel x:Name="MovePanel">
            <RadioButton x:Name="MoveRadio" GroupName="PromptsGo" IsChecked="True"
                         Checked="Choice_Changed" Unchecked="Choice_Changed" />
            <!-- The first other category is chosen at first, so the box is never empty. -->
            <ComboBox x:Name="TargetBox" AutomationProperties.Name="Move prompts to" Margin="28,6,0,0"
                      SelectionChanged="TargetBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <emoji:EmojiImage Text="{Binding Emoji}" Margin="0,0,6,0">
                                <emoji:EmojiImage.Style>
                                    <Style TargetType="emoji:EmojiImage">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Emoji}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </emoji:EmojiImage.Style>
                            </emoji:EmojiImage>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </StackPanel>
        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="28,4,0,0" />

        <!-- The other way out: delete the prompts with the category. -->
        <RadioButton x:Name="DeleteBox" GroupName="PromptsGo" Margin="0,12,0,0"
                     Checked="Choice_Changed" Unchecked="Choice_Changed"
                     ToolTip="Delete the prompts too instead of moving them" />
        <!-- Under the box that causes it: shown only while the prompts are to be deleted. -->
        <TextBlock x:Name="DeleteWarning" Style="{StaticResource ErrorText}" Text="This can't be undone." TextWrapping="Wrap"
                   Margin="28,4,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel" />
            <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Content="Move and delete" IsDefault="True"
                    IsEnabled="False"
                    Click="Action_Click" AutomationProperties.Name="Move and delete" />
        </StackPanel>
    </StackPanel>
</Window>
