<Window x:Class="PromptLibrary.App.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Restore from backup"
        AutomationProperties.Name="Restore from backup"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Damaged backups stay focusable (and readable by screen readers) but can't be restored. -->
        <Style x:Key="BackupRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Backups in" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Look in another folder…"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="ChooseFolder_Click"
                    ToolTip="Find backups in a different folder, e.g. on another drive"
                    AutomationProperties.Name="Look in another folder" />
        </Grid>

        <Border Margin="0,8,0,0" Height="240" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
            <Grid>
                <ListBox x:Name="BackupList" Style="{StaticResource PlainList}" Margin="0,4"
                         ItemContainerStyle="{StaticResource BackupRow}"
                         SelectionChanged="BackupList_SelectionChanged"
                         AutomationProperties.Name="Backups">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyPanel" Margin="16" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <Button x:Name="SetUpBackupsLink" Style="{StaticResource LinkButton}" Content="Set up backups"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                            Click="SetUpBackups_Click" AutomationProperties.Name="Set up backups" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    AutomationProperties.Name="Cancel" />
            <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Restore" IsDefault="True"
                    IsEnabled="False" Click="Restore_Click" AutomationProperties.Name="Restore selected backup" />
        </StackPanel>
    </StackPanel>
</Window>
