<Window x:Class="PromptLibrary.App.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Restore from backup"
        AutomationProperties.Name="Restore from backup"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Damaged backups stay focusable (and readable by screen readers) but can't be restored. -->
        <Style x:Key="BackupRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
        </Style>

        <DataTemplate x:Key="BackupRowTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadable}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- "Made automatically before a restore" under the copy a restore made first. -->
                <TextBlock Text="{Binding Note}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- A quiet show/hide header: chevron (right when closed, down when open) and a semibold label. -->
        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource Font.Icons}"
                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Root" Margin="16">
        <TextBlock Text="Backups in" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Look in another folder…"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="ChooseFolder_Click"
                    ToolTip="Find backups in a different folder, e.g. on another drive"
                    AutomationProperties.Name="Look in another folder" />
        </Grid>

        <Border Margin="0,8,0,0" Height="240" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
            <Grid>
                <ListBox x:Name="BackupList" Style="{StaticResource PlainList}" Margin="0,4"
                         ItemContainerStyle="{StaticResource BackupRow}"
                         ItemTemplate="{StaticResource BackupRowTemplate}"
                         SelectionChanged="BackupList_SelectionChanged"
                         AutomationProperties.Name="Backups" />
                <StackPanel x:Name="EmptyPanel" Margin="16" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <Button x:Name="SetUpBackupsLink" Style="{StaticResource LinkButton}" Content="Set up backups"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                            Click="SetUpBackups_Click" AutomationProperties.Name="Set up backups" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Copies of the library made just before earlier restores, kept in %APPDATA%\PromptLibrary\Safety backups.
             Only shown when there are some. -->
        <ToggleButton x:Name="SafetyToggle" Style="{StaticResource DisclosureToggle}" Margin="0,16,0,0"
                      HorizontalAlignment="Left" Visibility="Collapsed"
                      Content="Safety copies (made before a restore)"
                      ToolTip="Your library as it was just before each earlier restore"
                      AutomationProperties.Name="Safety copies (made before a restore)" />
        <Border x:Name="SafetyFrame" Margin="0,8,0,0" Height="120" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                Visibility="{Binding IsChecked, ElementName=SafetyToggle, Converter={StaticResource BoolToVisibility}}">
            <ListBox x:Name="SafetyList" Style="{StaticResource PlainList}" Margin="0,4"
                     ItemContainerStyle="{StaticResource BackupRow}"
                     ItemTemplate="{StaticResource BackupRowTemplate}"
                     SelectionChanged="SafetyList_SelectionChanged"
                     AutomationProperties.Name="Safety copies" />
        </Border>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    AutomationProperties.Name="Cancel" />
            <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Restore" IsDefault="True"
                    IsEnabled="False" Click="Restore_Click" AutomationProperties.Name="Restore selected backup" />
        </StackPanel>
    </StackPanel>
</Window>
