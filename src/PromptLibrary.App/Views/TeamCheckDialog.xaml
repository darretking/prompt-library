<Window x:Class="PromptLibrary.App.Views.TeamCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Check the team library"
        AutomationProperties.Name="Check the team library"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height" MaxHeight="560"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- One row (at least 40 px) per problem with a kind icon; a click goes to that prompt or category. -->
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                       Foreground="{DynamicResource Brush.Brand}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Everything looks good." VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Text="{Binding Heading}" Style="{StaticResource FieldLabel}" FontSize="14" Margin="0,0,0,8"
                   Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SubtleButton}" MinHeight="40" Padding="8,4"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="Row_Click" AutomationProperties.Name="{Binding Message}"
                                AutomationProperties.HelpText="Go to it">
                            <DockPanel LastChildFill="True" Width="456">
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Font.Icons}" Text="&#xE76C;"
                                           FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Font.Icons}" Text="{Binding Icon}" FontSize="16"
                                           Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </StackPanel>
</Window>
