<UserControl x:Class="PromptLibrary.App.Views.FillInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Fill in the blanks"
             Focusable="False">
    <!-- The placeholder form. Bind DataContext to a FillInViewModel. Tab moves between fields, Enter on the last
         field (or Ctrl+Enter anywhere) completes, Esc (or Backspace in an empty first field) cancels. -->
    <UserControl.Resources>
        <!-- Editable drop-down in the same field look as the text boxes. -->
        <ControlTemplate x:Key="FillComboToggle" TargetType="ToggleButton">
            <Border Background="Transparent" Width="28">
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                           Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <Style x:Key="FillCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <TextBox x:Name="PART_EditableTextBox" Padding="6,0,28,0"
                                     Background="{DynamicResource Brush.Surface}" />
                            <ToggleButton Template="{StaticResource FillComboToggle}" Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,0,0" Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius}" Padding="0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Style="{StaticResource PlaceholderBox}" Tag="{Binding Hint}"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Name}"
                                     Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Style="{StaticResource FillCombo}" ItemsSource="{Binding Options}"
                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{Binding Name}"
                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Live preview of the text as it will be pasted. -->
        <Grid Grid.Row="2" Margin="0,4,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Preview" Style="{StaticResource FieldLabel}" />
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Padding="8"
                               FontFamily="{StaticResource Font.Prompt}" FontSize="13"
                               Foreground="{DynamicResource Brush.Ink}"
                               AutomationProperties.Name="Preview of the filled prompt" />
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding CancelLabel}" Click="Cancel_Click" AutomationProperties.Name="{Binding CancelLabel}" />
            <Button Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    Click="Complete_Click" AutomationProperties.Name="{Binding PrimaryLabel}" />
        </StackPanel>
    </Grid>
</UserControl>
