<Window x:Class="PromptLibrary.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Prompt Library"
        Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button x:Name="LinkButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                Margin="0,8,0,0" Visibility="Collapsed" Click="Link_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Primary_Click" />
        </StackPanel>
    </StackPanel>
</Window>
