<Window x:Class="PromptLibrary.App.Views.TeamJoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Join a team library"
        AutomationProperties.Name="Join a team library"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- One box for a folder, file or link, Browse…, and Join. Checking… with a progress bar while it reads; an error
         shows under the box in Danger text. -->
    <StackPanel Margin="16">
        <TextBlock Text="Shared folder, file or link" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Style="{StaticResource {x:Type TextBox}}"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEdit}"
                     AutomationProperties.Name="Shared folder, file or link"
                     AutomationProperties.HelpText="Paste a folder, a file or an https link, or choose Browse" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"
                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Browse for a folder" />
        </Grid>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="A shared folder works best. A link must open the file itself: a GitHub raw link, a Dropbox link or any direct download link." />

        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Checking…" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,6,0,0"
                         Foreground="{DynamicResource Brush.Brand}" Background="{DynamicResource Brush.Line}"
                         BorderThickness="0" AutomationProperties.Name="Checking the team library" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="Join" IsDefault="True"
                    Command="{Binding JoinCommand}" AutomationProperties.Name="Join" />
        </StackPanel>
    </StackPanel>
</Window>
