<Window x:Class="PromptLibrary.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PromptLibrary.App.ViewModels"
        Style="{StaticResource AppDialog}"
        Title="Version history"
        AutomationProperties.Name="Version history"
        Icon="/Assets/app.ico"
        Width="760" Height="480" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DiffLineBorder" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Background" Value="{DynamicResource Brush.DiffAdded}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource Brush.DiffRemoved}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiffLineText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Prompt}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DiffAddedText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DiffRemovedText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty: nothing saved over yet. -->
        <TextBlock Grid.Row="0" Text="{x:Static vm:HistoryViewModel.EmptyText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="420" TextAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}">
                <ListBox x:Name="VersionList" Style="{StaticResource PlainList}" Margin="0,4"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource RowItem}"
                         AutomationProperties.Name="Earlier versions">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding When}">
                                <TextBlock Text="{Binding When}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FirstLine}" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Compare with current" Margin="12,0,0,0"
                                  IsChecked="{Binding CompareWithCurrent}"
                                  FocusVisualStyle="{StaticResource FocusRing}"
                                  ToolTip="Compare this version with the text in the editor now"
                                  AutomationProperties.Name="Compare with current" />
                        <TextBlock Text="{Binding DiffTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Changes in the chosen version">
                        <ItemsControl ItemsSource="{Binding Diff}" Margin="0,4" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DiffLineBorder}" Padding="8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Marker}" Style="{StaticResource DiffLineText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                       Style="{StaticResource DiffLineText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0" Click="Close_Click"
                    AutomationProperties.Name="Close" />
            <Button Content="Restore as a new prompt" Margin="0,0,8,0"
                    IsEnabled="{Binding CanRestore}" Click="RestoreNew_Click"
                    ToolTip="Keeps this version as a new prompt and leaves the open one as it is"
                    AutomationProperties.Name="Restore as a new prompt" />
            <Button Style="{StaticResource PrimaryButton}" Content="Restore this version" IsDefault="True"
                    IsEnabled="{Binding CanRestore}" Click="Restore_Click"
                    ToolTip="Puts this version in the editor as an unsaved change"
                    AutomationProperties.Name="Restore this version" />
        </StackPanel>
    </Grid>
</Window>
