<Window x:Class="PromptLibrary.App.Views.SuggestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Suggestions"
        AutomationProperties.Name="Suggestions"
        Icon="/Assets/app.ico"
        Width="760" Height="480" MinWidth="560" MinHeight="360"
        ShowInTaskbar="False">
    <!-- The list at the left (title, then "from · age"); the selected suggestion at the right. -->
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"
                AutomationProperties.Name="Close" />
        <Grid>
        <TextBlock Text="No suggestions right now." Margin="0,8,0,0" VerticalAlignment="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="Suggestions">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="Team category" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}"
                              DisplayMemberPath="Display" AutomationProperties.Name="Team category" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Dismiss" Margin="0,0,8,0" Command="{Binding DismissCommand}"
                                AutomationProperties.Name="Dismiss" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Add to team prompts"
                                Command="{Binding AddCommand}" AutomationProperties.Name="Add to team prompts" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Suggestion.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 Margin="0,8,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource Font.Prompt}" FontSize="13"
                                 AutomationProperties.Name="Prompt text" />
                        <TextBlock Text="{Binding Suggestion.Description}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Suggestion.Note, StringFormat=Note: {0}}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        </Grid>
    </DockPanel>
</Window>
