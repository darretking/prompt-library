<Window x:Class="PromptLibrary.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="Prompt Library"
        Icon="/Assets/app.ico"
        Width="1100" Height="700"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewPromptCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ShowYoursCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding ShowTeamCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ContextMenu x:Key="CategoryMenu" x:Shared="False">
            <MenuItem Header="_Rename" InputGestureText="F2" Click="RenameCategory_Click" />
            <MenuItem Header="_Delete" InputGestureText="Del" Click="DeleteCategory_Click" />
        </ContextMenu>

        <!-- Local tab navigation inside each row: Tab from the selected row goes to its Rename and Delete buttons
             before leaving the list (the list itself is still one Tab stop). -->
        <Style x:Key="CategoryRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
            <Style.Triggers>
                <!-- Team categories (read only) have no Rename or Delete. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAll}" Value="False" />
                        <Condition Binding="{Binding CanEdit}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContextMenu" Value="{StaticResource CategoryMenu}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A prompt row's right-click menu: Pin / Unpin, and for team prompts Hide from menu / Unhide. -->
        <ContextMenu x:Key="PromptMenu" x:Shared="False">
            <MenuItem Header="{Binding PinLabel}" IsEnabled="{Binding CanPin}" Click="PinPrompt_Click" />
            <MenuItem Header="{Binding HideLabel}" Click="HidePrompt_Click"
                      Visibility="{Binding IsTeam, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <Style x:Key="PromptRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="ContextMenu" Value="{StaticResource PromptMenu}" />
        </Style>

        <!-- A small Segoe Fluent icon beside text: the team icon (people), the pin, set by Text. -->
        <Style x:Key="InlineGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One half of the "Your prompts | Team prompts" switch; Tag is true on the side shown. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Window}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Shown" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary editor buttons (Pin, Hide from menu, Make my copy): outline, a little narrower so the Team
             row fits beside Copy prompt at the minimum window width. -->
        <Style x:Key="EditorOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Shown while a category row is not being renamed. -->
        <Style x:Key="HiddenWhileRenaming" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PromptDescription" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Text" Value="{Binding Description}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <!-- One line only, even if the description has line breaks. -->
            <Setter Property="MaxHeight" Value="16" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Description}" Value="">
                    <Setter Property="Text" Value="No description" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MutedWhenSet" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save: says "Saved" for 1.5 s after saving, at full strength although there's nothing left to save. -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor.IsShowingSaved}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
              AutomationProperties.Name="Menu">
            <MenuItem Header="_File" AutomationProperties.Name="File">
                <MenuItem Header="_Back up now" Command="{Binding BackupNowCommand}" />
                <MenuItem Header="_Restore from backup…" Command="{Binding RestoreCommand}" />
                <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Help" AutomationProperties.Name="Help">
                <MenuItem Header="_Setup guide…" Command="{Binding SetupGuideCommand}" />
                <MenuItem Header="Check for _updates…" Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="_About Prompt Library" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Once a team library is connected: the "Your prompts | Team prompts" switch over the three columns
                 (Ctrl+1 / Ctrl+2). The Team half carries the team icon and a dot while something is new or updated. -->
            <Border x:Name="SwitchBar" Grid.Row="1" Background="{StaticResource Brush.Rail}" Padding="16,8"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                    SizeChanged="TeamBars_SizeChanged" IsVisibleChanged="TeamBars_IsVisibleChanged"
                    Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" VerticalAlignment="Top" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="2">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Library">
                            <Button Style="{StaticResource SegmentButton}" Content="Your prompts"
                                    Tag="{Binding IsYoursSide}" Command="{Binding ShowYoursCommand}"
                                    ToolTip="Your prompts (Ctrl+1)" AutomationProperties.Name="Your prompts" />
                            <Button Style="{StaticResource SegmentButton}" Margin="2,0,0,0"
                                    Tag="{Binding IsTeamSide}" Command="{Binding ShowTeamCommand}"
                                    ToolTip="Team prompts (Ctrl+2)" AutomationProperties.Name="{Binding TeamSwitchName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource InlineGlyph}" Text="&#xE716;" Margin="0,0,6,0" />
                                    <TextBlock Text="Team prompts" />
                                    <Ellipse Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Top"
                                             Fill="{StaticResource Brush.Brand}"
                                             Visibility="{Binding TeamHasUnseen, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Team side, on the switch's line: "Acme best practice · updated today, 07:52" (or offline "Last
                         updated … · can't reach the team library · Retry") after the switch, trimmed only if the window is
                         very narrow (full text in the tooltip); "Edit team library" (or the muted "Read only"), "Mark all as
                         seen" and, for editors, the ⋯ menu at the right. A file made by a newer app says why it can't be
                         edited on a line below. -->
                    <DockPanel Margin="24,0,0,0" VerticalAlignment="Center" TextElement.FontSize="12"
                               Visibility="{Binding ShowTeamHeader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding TeamEditBlockedText}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   AutomationProperties.Name="{Binding TeamEditBlockedText}"
                                   Visibility="{Binding ShowTeamEditBlocked, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource LinkButton}" Content="Edit team library" Margin="8,0,0,0"
                                    Command="{Binding EditTeamCommand}"
                                    Visibility="{Binding ShowEditTeamButton, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Unlock the team library to change it for everyone"
                                    AutomationProperties.Name="Edit team library" />
                            <TextBlock Text="Read only" Style="{StaticResource MutedText}" Margin="8,0,0,0"
                                       ToolTip="{Binding TeamReadOnlyReason}"
                                       Visibility="{Binding ShowTeamReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Mark all as seen" Margin="8,0,0,0"
                                    Command="{Binding MarkAllSeenCommand}"
                                    Visibility="{Binding ShowMarkAllSeen, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Mark all as seen" />
                            <!-- The negative margin keeps the 24 px icon button from making the line taller. -->
                            <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="4,-5,-6,-5"
                                    Click="TeamMore_Click" ToolTip="More"
                                    Visibility="{Binding ShowTeamMoreMenu, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="More team library actions">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Restore an older version…"
                                                  Command="{Binding TeamHistoryCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TeamHeaderText}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="{Binding TeamHeaderText}">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TeamHeaderText}" />
                                            <TextBlock Text="{Binding TeamHeaderDetail}" Style="{StaticResource MutedWhenSet}" />
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Visibility="{Binding IsTeamOffline, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text=" · " Style="{StaticResource MutedText}" />
                                <Button Style="{StaticResource LinkButton}" Content="Retry"
                                        Command="{Binding RetryTeamCommand}"
                                        ToolTip="Read the team library again"
                                        AutomationProperties.Name="Retry" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Team side notices, one bar in the quiet warning-bar style (as the backup bar): "Editing team library:
                 changes go to everyone" + Done while editing, and for editors "Two versions of the team library
                 found" + Review while file sync has left a second version. Both share the line when both apply. -->
            <Border x:Name="TeamBar" Grid.Row="2" Background="{StaticResource Brush.Warn}" Padding="16,6"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                    SizeChanged="TeamBars_SizeChanged" IsVisibleChanged="TeamBars_IsVisibleChanged"
                    Visibility="{Binding ShowTeamBar, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel TextElement.FontSize="12">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowTeamEditBar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TeamEditBarText}" Foreground="{StaticResource Brush.WarnText}"
                                   Margin="0,0,8,0" AutomationProperties.Name="{Binding TeamEditBarText}" />
                        <Button Style="{StaticResource LinkButton}" Content="Done" FontWeight="SemiBold"
                                Command="{Binding DoneEditingTeamCommand}"
                                ToolTip="Lock the team library again" AutomationProperties.Name="Done" />
                    </StackPanel>
                    <TextBlock Text="·" Foreground="{StaticResource Brush.WarnText}" Margin="12,0"
                               Visibility="{Binding ShowBothTeamNotices, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowConflictBar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConflictBarText}" Foreground="{StaticResource Brush.WarnText}"
                                   Margin="0,0,8,0" AutomationProperties.Name="{Binding ConflictBarText}" />
                        <Button Style="{StaticResource LinkButton}" Content="Review" FontWeight="SemiBold"
                                Command="{Binding ReviewConflictCommand}"
                                ToolTip="See both versions and choose which one everyone gets"
                                AutomationProperties.Name="Review" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="3">
                <!-- At the minimum window size the list column gives way so the editor keeps its 420 px. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- Left: category rail -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Rail}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Categories" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" Height="32" Padding="0,8,0,0" Margin="16,16,16,8" />

                        <ListBox x:Name="RailList" Grid.Row="1" Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 ItemContainerStyle="{StaticResource CategoryRow}"
                                 KeyDown="RailList_KeyDown"
                                 AutomationProperties.Name="Categories">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid Style="{StaticResource HiddenWhileRenaming}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="CountText" Grid.Column="1" Text="{Binding Count}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <!-- Rename / Delete on the selected, hovered or keyboard-focused row; Tab from
                                                 the selected row reaches them (see CategoryRow). The negative margin keeps
                                                 the 24 px buttons from making the row taller. -->
                                            <StackPanel x:Name="RowActions" Grid.Column="2" Orientation="Horizontal"
                                                        Margin="4,-4,-8,-4" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                        Click="RenameCategory_Click"
                                                        ToolTip="Rename (F2)"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Rename {0}}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                        Click="DeleteCategory_Click"
                                                        ToolTip="Delete (Del)"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Category name"
                                                     KeyDown="RenameBox_KeyDown"
                                                     LostKeyboardFocus="RenameBox_LostKeyboardFocus"
                                                     IsVisibleChanged="InlineBox_IsVisibleChanged" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
                                            <TextBlock Text="Enter to save, Esc to cancel" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Count}" Value="0">
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAll}" Value="False" />
                                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAll}" Value="False" />
                                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAll}" Value="False" />
                                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="8,8,8,16">
                            <!-- A newer version is known (the user said Not now): stays until they update. -->
                            <Button Style="{StaticResource LinkButton}" Content="{Binding UpdateReminder}"
                                    Command="{Binding OpenUpdateCommand}" HorizontalAlignment="Left"
                                    Margin="8,0,8,8" ToolTip="Click to update"
                                    AutomationProperties.Name="{Binding UpdateReminder}"
                                    Visibility="{Binding ShowUpdateReminder, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedWhenSet}"
                                       Margin="8,0,8,8" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Margin="8,0,8,8"
                                        Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBox x:Name="NewCategoryBox"
                                         Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="New category name"
                                         KeyDown="NewCategoryBox_KeyDown"
                                         LostKeyboardFocus="NewCategoryBox_LostKeyboardFocus"
                                         IsVisibleChanged="InlineBox_IsVisibleChanged" />
                                <TextBlock Text="{Binding NewCategoryError}" Style="{StaticResource ErrorText}" />
                                <TextBlock Text="Enter to add, Esc to cancel" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource TextButton}" Content="+ New category"
                                    Command="{Binding NewCategoryCommand}"
                                    Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="New category" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: (Team header line), search and prompt list -->
                <Border Grid.Column="1" Background="{StaticResource Brush.Window}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <Grid Grid.Row="1" Margin="16,16,16,8">
                            <TextBox x:Name="SearchBox" Style="{StaticResource PlaceholderBox}"
                                     Tag="Search prompts" Padding="6,0,28,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search titles, descriptions and prompt text (Ctrl+F)"
                                     AutomationProperties.Name="Search prompts"
                                     KeyDown="SearchBox_KeyDown" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                    HorizontalAlignment="Right" Margin="0,0,4,0" Focusable="False"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search" />
                        </Grid>

                        <!-- Only while some team prompts are hidden from the menu: lists them greyed, each with Unhide. -->
                        <CheckBox Grid.Row="2" Margin="16,0,16,8" Content="{Binding ShowHiddenText}"
                                  IsChecked="{Binding ShowHiddenTeamPrompts}"
                                  FocusVisualStyle="{StaticResource FocusRing}"
                                  Visibility="{Binding ShowHiddenToggle, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="{Binding ShowHiddenText}" />

                        <ListBox x:Name="PromptList" Grid.Row="3" Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding Prompts}"
                                 SelectedItem="{Binding SelectedPrompt}"
                                 ItemContainerStyle="{StaticResource PromptRow}"
                                 KeyDown="PromptList_KeyDown"
                                 AutomationProperties.Name="Prompts">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Rows stay quiet: the team icon only in search results, then a New / Updated tag
                                         and a small pin where they apply. Hidden rows (Show hidden) are greyed. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineGlyph}"
                                                           Text="&#xE716;" Margin="0,0,6,0" ToolTip="Team prompt"
                                                           Visibility="{Binding ShowTeamIcon, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource PromptDescription}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Margin="8,0,0,0">
                                            <Border x:Name="MarkerTag" Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Brand}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius}" Padding="4,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MarkerText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Brand}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource InlineGlyph}" Text="&#xE718;"
                                                       Margin="6,0,0,0" ToolTip="Pinned"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding MarkerText}" Value="{x:Null}">
                                            <Setter TargetName="MarkerTag" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                            <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource Brush.Muted}" />
                                            <Setter TargetName="RowTitle" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="RowTitle" Property="ToolTip" Value="Hidden from the menu (right-click to unhide)" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Margin="16,8,16,0"
                                    Visibility="{Binding ShowNoPromptsYet, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="No prompts yet" FontWeight="SemiBold" />
                            <Button x:Name="EmptyNewPromptButton" Content="New prompt" Command="{Binding NewPromptCommand}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0"
                                    ToolTip="New prompt (Ctrl+N)" AutomationProperties.Name="New prompt" />
                        </StackPanel>

                        <!-- Team side states: loading, empty, everything hidden. -->
                        <TextBlock Grid.Row="3" Margin="16,8,16,0" Text="Loading team prompts…"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding IsTeamLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Margin="16,8,16,0" Text="No team prompts yet." FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowNoTeamPrompts, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Margin="16,8,16,0" Text="{Binding AllHiddenText}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowAllHidden, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Grid.Row="3" Margin="16,8,16,0"
                                    Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding NoMatchesText}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource LinkButton}" Content="Clear search"
                                    Command="{Binding ClearSearchCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    AutomationProperties.Name="Clear search" />
                        </StackPanel>

                        <Button Grid.Row="4" Style="{StaticResource TextButton}" Content="+ New prompt"
                                Margin="8,8,8,16" Command="{Binding NewPromptCommand}"
                                Visibility="{Binding ShowNewPromptFooter, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="New prompt (Ctrl+N)" AutomationProperties.Name="New prompt" />
                    </Grid>
                </Border>

                <!-- Right: editor -->
                <Grid Grid.Column="2">
                    <TextBlock Text="{Binding NoEditorText}" Foreground="{StaticResource Brush.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="16"
                               Visibility="{Binding HasNoEditor, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="16" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <!-- 64 = three lines, so a new prompt (with its heading) still fits at the minimum window height;
                                 40 while the buttons take two lines (see MainWindow.ButtonRow_SizeChanged). -->
                            <RowDefinition x:Name="SlipRow" Height="*" MinHeight="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <!-- A team prompt while the team library isn't being edited: one lock line, the fields
                                 below are normal, selectable text that can't be changed. -->
                            <DockPanel Margin="0,0,0,8">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LockLineText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineGlyph}" Text="&#xE716;"
                                           Foreground="{StaticResource Brush.Muted}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LockLineText}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" AutomationProperties.Name="{Binding LockLineText}" />
                            </DockPanel>
                            <!-- Says this is a new, not yet saved prompt. -->
                            <TextBlock Text="New prompt" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Visibility="{Binding Editor.IsNew, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleBox" Style="{StaticResource PlaceholderBox}" Tag="Untitled prompt"
                                     FontSize="18" FontWeight="SemiBold"
                                     Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding Editor.IsReadOnly}"
                                     AutomationProperties.Name="Title" />
                            <TextBlock Text="{Binding Editor.TitleError}" Style="{StaticResource ErrorText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding Editor.IsReadOnly}"
                                     AutomationProperties.Name="Description" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,16">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="240" HorizontalAlignment="Left"
                                      ItemsSource="{Binding CategoryChoices}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding Editor.CategoryId}"
                                      Visibility="{Binding Editor.IsEditable, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Category">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <!-- Read only: the category as plain text. -->
                            <TextBlock Text="{Binding EditorCategoryName}" Padding="0,4"
                                       AutomationProperties.Name="{Binding EditorCategoryName, StringFormat=Category {0}}"
                                       Visibility="{Binding Editor.IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Editor.CategoryError}" Style="{StaticResource ErrorText}" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,0,0,4">
                            <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding Editor.TextStats}" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- The prompt slip: white, 1 px Line frame, 4 px Brand left edge. -->
                        <Grid Grid.Row="4">
                            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius}" />
                            <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource Brush.Brand}"
                                    CornerRadius="4,0,0,4" />
                            <TextBox x:Name="PromptBox" Style="{StaticResource SlipTextBox}" Margin="4,1,1,1"
                                     Text="{Binding Editor.Text, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding Editor.IsReadOnly}"
                                     PreviewKeyDown="PromptBox_PreviewKeyDown"
                                     AutomationProperties.Name="Prompt text"
                                     AutomationProperties.HelpText="Ctrl+Tab inserts a tab" />
                            <Border BorderBrush="{StaticResource Brush.Brand}" BorderThickness="2"
                                    CornerRadius="{StaticResource Radius}" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PromptBox}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <!-- The tab hint and the prompt's error; left out for a read-only prompt, which can have
                             neither, so its wider Team button row still fits at the minimum window size. -->
                        <DockPanel Grid.Row="5" Margin="0,4,0,0"
                                   Visibility="{Binding Editor.IsEditable, Converter={StaticResource BoolToVisibility}}">
                            <!-- Only while typing in the prompt box (Hidden, not Collapsed, so nothing moves). -->
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Tab inserts a tab" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=PromptBox}" Value="True" />
                                                    <Condition Binding="{Binding Editor.IsReadOnly}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Editor.TextError}" Style="{StaticResource ErrorText}" Margin="0" />
                        </DockPanel>

                        <!-- Left group outline, right group ending in the one filled button:
                             Your prompts: Delete · Pin | Save · Copy prompt
                             Team prompts: Pin · Hide from menu | Make my copy · Copy prompt
                             Team prompts while editing: Delete · Pin | Save · Copy prompt -->
                        <!-- Two groups; when both don't fit on one line (near the minimum width), the right group moves
                             under the left one, still right-aligned (MainWindow.ArrangeButtonRow). -->
                        <Grid x:Name="ButtonRow" Grid.Row="6" Margin="0,16,0,0" SizeChanged="ButtonRow_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="LeftButtons" Orientation="Horizontal" HorizontalAlignment="Left"
                                        SizeChanged="ButtonRow_SizeChanged">
                                <Button Style="{StaticResource DangerOutlineButton}" Content="Delete"
                                        Margin="0,0,8,0" Command="{Binding DeleteCommand}"
                                        Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Delete this prompt (Delete key in the list)"
                                        AutomationProperties.Name="Delete prompt" />
                                <Button Style="{StaticResource EditorOutlineButton}" Content="{Binding PinLabel}"
                                        Command="{Binding PinCommand}" IsEnabled="{Binding CanPin}"
                                        ToolTip="Pinned prompts show at the top of the shortcut menu"
                                        AutomationProperties.Name="{Binding PinLabel}" />
                                <Button Style="{StaticResource EditorOutlineButton}" Content="{Binding HideLabel}"
                                        Command="{Binding HideCommand}"
                                        Visibility="{Binding ShowTeamButtons, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Hidden prompts are left out of the shortcut menu"
                                        AutomationProperties.Name="{Binding HideLabel}" />
                            </StackPanel>
                            <StackPanel x:Name="RightButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                        SizeChanged="ButtonRow_SizeChanged">
                                <Button Style="{StaticResource SaveButton}" Content="{Binding Editor.SaveLabel}"
                                        Margin="0,0,8,0"
                                        Command="{Binding SaveCommand}" IsEnabled="{Binding Editor.IsDirty}"
                                        Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save" />
                                <Button Style="{StaticResource EditorOutlineButton}" Content="Make my copy"
                                        Command="{Binding CopyToYoursCommand}"
                                        Visibility="{Binding ShowTeamButtons, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Copy it into your prompts, where you can change it"
                                        AutomationProperties.Name="Make my copy" />
                                <Button Style="{StaticResource PrimaryButton}" MinWidth="128"
                                        Content="{Binding Editor.CopyLabel}"
                                        Command="{Binding CopyCommand}" IsEnabled="{Binding Editor.CanCopy}"
                                        ToolTip="Copy prompt (Ctrl+Shift+C)" AutomationProperties.Name="Copy prompt" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Declared last so it comes last in Tab order; shown at the top. -->
            <!-- Backups off / paused: a quiet 12 px bar with the link right after the sentence. -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Warn}" Padding="16,6"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                    ToolTip="{Binding BackupWarningDetail}"
                    Visibility="{Binding ShowBackupWarning, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel TextElement.FontSize="12">
                    <TextBlock Text="{Binding BackupWarning}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.WarnText}" Margin="0,0,8,0" />
                    <!-- "Set up backups" when they're off; "Check backups" when a chosen folder can't be reached. -->
                    <Button Command="{Binding SetUpBackupsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Content" Value="Check backups" />
                                <Setter Property="AutomationProperties.Name" Value="Check backups" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupWarningDetail}" Value="{x:Null}">
                                        <Setter Property="Content" Value="Set up backups" />
                                        <Setter Property="AutomationProperties.Name" Value="Set up backups" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
