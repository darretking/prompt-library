<Window x:Class="PromptLibrary.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PromptLibrary.App.Views.Controls"
        xmlns:emoji="clr-namespace:PromptLibrary.App.Views.Controls"
        xmlns:views="clr-namespace:PromptLibrary.App.Views"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="Prompt Library"
        Icon="/Assets/app.ico"
        Width="1100" Height="700"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- Custom Windows 11 title bar: the client area starts at the top edge (glass, so Mica shows through) and the top row is
         the caption (its height follows DWM's caption band, see MainWindow.UpdateMaximizedInset). DWM draws the native caption
         buttons (UseAeroCaptionButtons). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" UseAeroCaptionButtons="True" CornerRadius="0"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewPromptCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ShowYoursCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding ShowTeamCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ContextMenu x:Key="CategoryMenu" x:Shared="False" Style="{StaticResource FlyoutMenu}">
            <MenuItem Style="{StaticResource FlyoutItem}" Header="_Rename" InputGestureText="F2" Click="RenameCategory_Click" />
            <MenuItem Style="{StaticResource FlyoutItem}" Header="Change _emoji…" Click="ChangeEmoji_Click" />
            <MenuItem Style="{StaticResource FlyoutItem}" Header="_Delete" InputGestureText="Del" Click="DeleteCategory_Click" />
        </ContextMenu>

        <!-- Local tab navigation inside each row: Tab from the selected row goes to its Rename and Delete buttons
             before leaving the list (the list itself is still one Tab stop). -->
        <Style x:Key="CategoryRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
            <!-- 34 px plus the pill's 1 px above and below = a 36 px row. -->
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,4,8,4" />
            <Style.Triggers>
                <!-- Team categories (read only) have no Rename or Delete; nor do All prompts and Recent. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCategory}" Value="True" />
                        <Condition Binding="{Binding CanEdit}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContextMenu" Value="{StaticResource CategoryMenu}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A prompt row's right-click menu: Pin / Unpin, and for team prompts Hide from menu / Unhide. -->
        <ContextMenu x:Key="PromptMenu" x:Shared="False" Style="{StaticResource FlyoutMenu}">
            <MenuItem Style="{StaticResource FlyoutItem}" Header="{Binding PinLabel}" IsEnabled="{Binding CanPin}" Click="PinPrompt_Click" />
            <MenuItem Style="{StaticResource FlyoutItem}" Header="{Binding HideLabel}" Click="HidePrompt_Click"
                      Visibility="{Binding IsTeam, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <Style x:Key="PromptRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="ContextMenu" Value="{StaticResource PromptMenu}" />
        </Style>

        <!-- A small Segoe Fluent icon beside text: the team icon (people), the pin, set by Text. -->
        <Style x:Key="InlineGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One half of the "Your prompts | Team prompts" switch; Tag is true on the side shown. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BrandSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Brand}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Shown" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary editor buttons (Pin, Hide from menu, Make my copy): outline, a little narrower so the Team
             row fits beside Copy prompt at the minimum window width. -->
        <Style x:Key="EditorOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Shown while a category row is not being renamed. -->
        <Style x:Key="HiddenWhileRenaming" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PromptDescription" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <!-- One line only, even if the description has line breaks. -->
            <Setter Property="MaxHeight" Value="16" />
        </Style>

        <!-- A category's name with its emoji in front (menu entries). -->
        <DataTemplate x:Key="CategoryNameTemplate">
            <StackPanel Orientation="Horizontal">
                <emoji:EmojiImage Text="{Binding Emoji}" Margin="0,0,6,0">
                    <emoji:EmojiImage.Style>
                        <Style TargetType="emoji:EmojiImage">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Emoji}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </emoji:EmojiImage.Style>
                </emoji:EmojiImage>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!-- The 48 px Segoe Fluent glyph above an empty state's words. -->
        <Style x:Key="EmptyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="MutedWhenSet" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save: a subtle header button that exists only while there is something to save (it is enabled then). It fades in
             and out over 83 ms; disabled it is invisible, takes no clicks and is skipped by Tab. -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="{x:Static views:Motion.Fast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0"
                                                 Duration="{x:Static views:Motion.Fast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The two halves of the subtle Send to | v split button. -->
        <Style x:Key="SubtleSplitLeft" TargetType="Button" BasedOn="{StaticResource SplitLeftButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BrandSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SubtleSplitRight" TargetType="Button" BasedOn="{StaticResource SplitRightButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BrandSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (Windows 11 style): as tall as DWM's caption band (set in code from the system metrics, about 30 px), in the
             window's own client area so Mica shows through. The
             app icon at a 16 px inset, the File and Help menus, the title. The right 144 px are left for the native minimise /
             maximise / close buttons that DWM draws over this row (snap layouts keep working). The rest of the row drags the window. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="16" Height="16" Margin="16,0,4,0" Source="/Assets/app.ico"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
            <Menu Grid.Column="1" VerticalAlignment="Stretch" Margin="4,0,0,0" Padding="4,0" WindowChrome.IsHitTestVisibleInChrome="True"
                  AutomationProperties.Name="Menu">
            <MenuItem Style="{StaticResource MenuBarHeader}" Header="_File" AutomationProperties.Name="File">
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Back up now" Command="{Binding BackupNowCommand}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Restore from backup…" Command="{Binding RestoreCommand}" />
                <Separator Style="{StaticResource FlyoutSeparator}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Import prompts…" Command="{Binding ImportCommand}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Export prompts…" Command="{Binding ExportCommand}" />
                <Separator Style="{StaticResource FlyoutSeparator}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
                <Separator Style="{StaticResource FlyoutSeparator}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Style="{StaticResource MenuBarHeader}" Header="_Help" AutomationProperties.Name="Help">
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_Setup guide…" Command="{Binding SetupGuideCommand}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="Check for _updates…" Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_What's new" Command="{Binding ChangelogCommand}"
                          ToolTip="Opens the changelog on GitHub" />
                <MenuItem Style="{StaticResource FlyoutItem}" Header="_About Prompt Library" Command="{Binding AboutCommand}" />
            </MenuItem>
            </Menu>

            <!-- The window title in Caption style (12 px); the unsaved dot comes with it; dims while the window is inactive. -->
            <TextBlock Grid.Column="2" Text="{Binding WindowTitle}" FontSize="12" Margin="12,0,8,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                       AutomationProperties.Name="{Binding WindowTitle}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Once a team library is connected: the "Your prompts | Team prompts" switch over the three columns
                 (Ctrl+1 / Ctrl+2). The Team half carries the team icon and a dot while something is new or updated. -->
            <Border x:Name="SwitchBar" Grid.Row="1" Background="{DynamicResource Brush.RailBackdrop}" Padding="16,8"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                    SizeChanged="TeamBars_SizeChanged" IsVisibleChanged="TeamBars_IsVisibleChanged"
                    Visibility="{Binding ShowSwitch, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" VerticalAlignment="Top" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="2">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Library">
                            <Button Style="{StaticResource SegmentButton}" Content="Your prompts"
                                    Tag="{Binding IsYoursSide}" Command="{Binding ShowYoursCommand}"
                                    ToolTip="Your prompts (Ctrl+1)" AutomationProperties.Name="Your prompts" />
                            <Button Style="{StaticResource SegmentButton}" Margin="2,0,0,0"
                                    Tag="{Binding IsTeamSide}" Command="{Binding ShowTeamCommand}"
                                    ToolTip="Team prompts (Ctrl+2)" AutomationProperties.Name="{Binding TeamSwitchName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource InlineGlyph}" Text="&#xE716;" Margin="0,0,6,0" />
                                    <TextBlock Text="Team prompts" />
                                    <Ellipse Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Top"
                                             Fill="{DynamicResource Brush.Brand}"
                                             Visibility="{Binding TeamHasUnseen, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Team side, on the switch's line: "Acme best practice · updated today, 07:52" (or offline "Last
                         updated … · can't reach the team library · Retry") after the switch, trimmed only if the window is
                         very narrow (full text in the tooltip); "Edit team library" (or the muted "Read only"), "Mark all as
                         seen" and, for editors, the ⋯ menu at the right. A file made by a newer app says why it can't be
                         edited on a line below. -->
                    <DockPanel Margin="24,0,0,0" VerticalAlignment="Center" TextElement.FontSize="12"
                               Visibility="{Binding ShowTeamHeader, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding TeamEditBlockedText}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   AutomationProperties.Name="{Binding TeamEditBlockedText}"
                                   Visibility="{Binding ShowTeamEditBlocked, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource LinkButton}" Content="Edit team library" Margin="8,0,0,0"
                                    Command="{Binding EditTeamCommand}"
                                    Visibility="{Binding ShowEditTeamButton, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Unlock the team library to change it for everyone"
                                    AutomationProperties.Name="Edit team library" />
                            <TextBlock Text="Read only" Style="{StaticResource MutedText}" Margin="8,0,0,0"
                                       ToolTip="{Binding TeamReadOnlyReason}"
                                       Visibility="{Binding ShowTeamReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Mark all as seen" Margin="8,0,0,0"
                                    Command="{Binding MarkAllSeenCommand}"
                                    Visibility="{Binding ShowMarkAllSeen, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Mark all as seen" />
                            <!-- The negative margin keeps the 24 px icon button from making the line taller. -->
                            <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="4,-5,-6,-5"
                                    Click="TeamMore_Click" ToolTip="More"
                                    Visibility="{Binding ShowTeamMoreMenu, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="More team library actions">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FlyoutMenu}">
                                        <MenuItem Style="{StaticResource FlyoutItem}" Header="_Restore an older version…"
                                                  Command="{Binding TeamHistoryCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TeamHeaderText}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="{Binding TeamHeaderText}">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TeamHeaderText}" />
                                            <TextBlock Text="{Binding TeamHeaderDetail}" Style="{StaticResource MutedWhenSet}" />
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Visibility="{Binding IsTeamOffline, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text=" · " Style="{StaticResource MutedText}" />
                                <Button Style="{StaticResource LinkButton}" Content="Retry"
                                        Command="{Binding RetryTeamCommand}"
                                        ToolTip="Read the team library again"
                                        AutomationProperties.Name="Retry" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Team side notices, one bar in the quiet warning-bar style (as the backup bar): "Editing team library:
                 changes go to everyone" + Done while editing, and for editors "Two versions of the team library
                 found" + Review while file sync has left a second version. Both share the line when both apply. -->
            <Border x:Name="TeamBar" Grid.Row="2" Background="{DynamicResource Brush.Warn}" Padding="16,6"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                    SizeChanged="TeamBars_SizeChanged" IsVisibleChanged="TeamBars_IsVisibleChanged"
                    Visibility="{Binding ShowTeamBar, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel TextElement.FontSize="12">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowTeamEditBar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TeamEditBarText}" Foreground="{DynamicResource Brush.WarnText}"
                                   Margin="0,0,8,0" AutomationProperties.Name="{Binding TeamEditBarText}" />
                        <Button Style="{StaticResource LinkButton}" Content="Done" FontWeight="SemiBold"
                                Command="{Binding DoneEditingTeamCommand}"
                                ToolTip="Lock the team library again" AutomationProperties.Name="Done" />
                    </StackPanel>
                    <TextBlock Text="·" Foreground="{DynamicResource Brush.WarnText}" Margin="12,0"
                               Visibility="{Binding ShowBothTeamNotices, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowConflictBar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConflictBarText}" Foreground="{DynamicResource Brush.WarnText}"
                                   Margin="0,0,8,0" AutomationProperties.Name="{Binding ConflictBarText}" />
                        <Button Style="{StaticResource LinkButton}" Content="Review" FontWeight="SemiBold"
                                Command="{Binding ReviewConflictCommand}"
                                ToolTip="See both versions and choose which one everyone gets"
                                AutomationProperties.Name="Review" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="3">
                <!-- Rail 200 px (long names ellipsize, tooltip has the full name). At the minimum window size the list column gives way so the editor keeps its 420 px.
                     Rail and list sit on the window (Mica) layer with no divider lines between them; the editor is a card on top. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- Left: category rail -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.RailBackdrop}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section header: "Categories" 12 px semibold Muted, the + (add a category) at its right. -->
                        <DockPanel Grid.Row="0" Margin="18,12,12,4" Height="32">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                                    Command="{Binding NewCategoryCommand}"
                                    Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Add a category" AutomationProperties.Name="New category" />
                            <TextBlock Text="Categories" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox x:Name="RailList" Grid.Row="1" Style="{StaticResource PlainList}" controls:ScrollFade.Enabled="True"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 ItemContainerStyle="{StaticResource CategoryRow}"
                                 KeyDown="RailList_KeyDown"
                                 AutomationProperties.Name="Categories">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid Style="{StaticResource HiddenWhileRenaming}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- A fixed 22 px column so names line up: every row's colour emoji (All prompts, Recent and
                                                 categories without one get a default) on a faint rounded tile, so dark emoji stay visible in dark mode. -->
                                            <Border Width="22" Height="22" CornerRadius="{StaticResource Radius}"
                                                    Background="{DynamicResource Brush.EmojiTile}" BorderBrush="{DynamicResource Brush.EmojiTileRing}" BorderThickness="1">
                                                <emoji:EmojiImage Text="{Binding RailEmoji}" FontSize="14" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <!-- The count is muted and shows only on the selected or pointed-at row (All prompts always). -->
                                            <TextBlock x:Name="CountText" Grid.Column="2" Text="{Binding Count}"
                                                       Style="{StaticResource MutedText}" Visibility="Collapsed"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <!-- Rename / Delete only while the row is pointed at or has the keyboard focus (not for selection
                                                 alone); Tab from the selected row reaches them (see CategoryRow). The negative margin keeps
                                                 the 24 px buttons from making the row taller. -->
                                            <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal"
                                                        Margin="4,-4,-4,-4" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                        Click="RenameCategory_Click"
                                                        ToolTip="Rename (F2)"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Rename {0}}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                        Click="DeleteCategory_Click"
                                                        ToolTip="Delete (Del)"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                                            <!-- The emoji button, then the name. Moving between them does not end the edit. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:EmojiButton SelectedEmoji="{Binding EditEmoji, Mode=TwoWay}"
                                                                      Margin="0,0,4,0" VerticalAlignment="Top"
                                                                      Picked="RenameEmoji_Picked"
                                                                      LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                                                <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Category name"
                                                         KeyDown="RenameBox_KeyDown"
                                                         LostKeyboardFocus="RenameBox_LostKeyboardFocus"
                                                         IsVisibleChanged="InlineBox_IsVisibleChanged" />
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
                                            <TextBlock Text="Enter to save, Esc to cancel" Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAll}" Value="True">
                                            <Setter TargetName="CountText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="CountText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="CountText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCategory}" Value="True" />
                                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCategory}" Value="True" />
                                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Count}" Value="0">
                                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="8,8,8,16">
                            <!-- A newer version is known (the user said Not now): stays until they update. -->
                            <Button Style="{StaticResource LinkButton}" Content="{Binding UpdateReminder}"
                                    Command="{Binding OpenUpdateCommand}" HorizontalAlignment="Left"
                                    Margin="8,0,8,8" ToolTip="Click to update"
                                    AutomationProperties.Name="{Binding UpdateReminder}"
                                    Visibility="{Binding ShowUpdateReminder, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedWhenSet}"
                                       Margin="8,0,8,0" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Margin="8,8,8,0"
                                        Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:EmojiButton SelectedEmoji="{Binding NewCategoryEmoji, Mode=TwoWay}"
                                                          Margin="0,0,4,0" VerticalAlignment="Top"
                                                          Picked="NewEmoji_Picked"
                                                          LostKeyboardFocus="NewCategoryBox_LostKeyboardFocus" />
                                    <TextBox x:Name="NewCategoryBox" Grid.Column="1"
                                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="New category name"
                                             KeyDown="NewCategoryBox_KeyDown"
                                             LostKeyboardFocus="NewCategoryBox_LostKeyboardFocus"
                                             IsVisibleChanged="InlineBox_IsVisibleChanged" />
                                </Grid>
                                <TextBlock Text="{Binding NewCategoryError}" Style="{StaticResource ErrorText}" />
                                <TextBlock Text="Enter to add, Esc to cancel" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Middle: search with the New prompt icon button, then the prompt list -->
                <Border Grid.Column="1" Background="{DynamicResource Brush.WindowBackdrop}">
                    <!-- The list column is its own subtle layer (Fluent LayerFillColorDefault) over the backdrop; the rail stays on
                         the base and the editor card is the strongest layer. Flat while the library is empty. -->
                    <Grid x:Name="ListColumn">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource Brush.ListLayer}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNoPromptsYet}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="8,12,8,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowNoPromptsYet}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox" Style="{StaticResource PlaceholderBox}"
                                         Tag="Search prompts" Padding="6,0,28,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search titles, descriptions and prompt text. Add #tag or cat:name to narrow it down (Ctrl+F)"
                                         AutomationProperties.Name="Search prompts"
                                         KeyDown="SearchBox_KeyDown" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                        HorizontalAlignment="Right" Margin="0,0,4,0" Focusable="False"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search" />
                            </Grid>
                            <Button Grid.Column="1" Width="32" MinWidth="32" Padding="0" Margin="8,0,0,0"
                                    FontFamily="{StaticResource Font.Icons}" FontSize="14" Content="&#xE710;"
                                    Command="{Binding NewPromptCommand}"
                                    Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="New prompt (Ctrl+N)" AutomationProperties.Name="New prompt" />
                        </Grid>

                        <!-- Only while some team prompts are hidden from the menu: lists them greyed, each with Unhide. -->
                        <CheckBox Grid.Row="1" Margin="16,0,16,8" Content="{Binding ShowHiddenText}"
                                  IsChecked="{Binding ShowHiddenTeamPrompts}"
                                  FocusVisualStyle="{StaticResource FocusRing}"
                                  Visibility="{Binding ShowHiddenToggle, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="{Binding ShowHiddenText}" />

                        <ListBox x:Name="PromptList" Grid.Row="2" Style="{StaticResource PlainList}" controls:ScrollFade.Enabled="True"
                                 ItemsSource="{Binding Prompts}"
                                 SelectedItem="{Binding SelectedPrompt}"
                                 ItemContainerStyle="{StaticResource PromptRow}"
                                 KeyDown="PromptList_KeyDown"
                                 AutomationProperties.Name="Prompts">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Rows stay quiet: title (matched letters in Brand while searching), the description on one
                                         line and, when they fit after it, up to three tag chips. The team icon only in search
                                         results, then a New / Updated tag and a small pin at the right where they apply. Hidden
                                         rows (Show hidden) are greyed. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineGlyph}"
                                                           Text="&#xE716;" Margin="0,0,6,0" ToolTip="Team prompt"
                                                           Visibility="{Binding ShowTeamIcon, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock x:Name="RowTitle" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           views:InlineText.Highlight="MatchBold"
                                                           views:InlineText.Segments="{Binding TitleSegments}" />
                                            </DockPanel>
                                            <controls:InlineFitPanel Gap="8" Margin="0,2,0,0">
                                                <Grid>
                                                    <TextBlock Style="{StaticResource PromptDescription}"
                                                               views:InlineText.Highlight="MatchBold"
                                                               views:InlineText.Segments="{Binding DescriptionSegments}" />
                                                    <TextBlock x:Name="NoDescription" Text="No description"
                                                               Style="{StaticResource PromptDescription}" FontStyle="Italic"
                                                               Visibility="Collapsed" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding TagChips}" Focusable="False" IsTabStop="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.BrandSoft}"
                                                                    CornerRadius="{StaticResource Radius}" Padding="6,0"
                                                                    Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding}" FontSize="12" LineHeight="16"
                                                                           LineStackingStrategy="BlockLineHeight"
                                                                           Foreground="{DynamicResource Brush.Muted}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </controls:InlineFitPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <Border x:Name="MarkerTag" Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Brand}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius}" Padding="4,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MarkerText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Brand}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource InlineGlyph}" Text="&#xE718;"
                                                       Margin="6,0,0,0" ToolTip="Pinned"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding MarkerText}" Value="{x:Null}">
                                            <Setter TargetName="MarkerTag" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                            <Setter TargetName="NoDescription" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                            <Setter TargetName="RowTitle" Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                            <Setter TargetName="RowTitle" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="RowTitle" Property="ToolTip" Value="Hidden from the menu (right-click to unhide)" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Team side states: loading, empty, everything hidden. -->
                        <TextBlock Grid.Row="2" Margin="16,8,16,0" Text="Loading team prompts…"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding IsTeamLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="2" Margin="16,8,16,0" Text="No team prompts yet." FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowNoTeamPrompts, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="2" Margin="16,8,16,0" Text="{Binding AllHiddenText}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowAllHidden, Converter={StaticResource BoolToVisibility}}" />

                        <!-- No match: glyph, what was searched, a hint, Clear search. -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16,0,16,56"
                                    Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyGlyph}" Text="&#xE721;" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NoMatchesHeadline}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="Center" AutomationProperties.Name="{Binding NoMatchesText}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,6,0,0" Text="Try fewer words, or search tags with #" />
                            <Button Style="{StaticResource LinkButton}" Content="Clear search"
                                    Command="{Binding ClearSearchCommand}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    ToolTip="Show all prompts again (Esc)" AutomationProperties.Name="Clear search" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: the editor, a card on the window layer (Surface, 1 px Line, 8 px radius, 12 px from every edge, the list's included, a very
                     soft shadow that MainWindow switches off on low-tier graphics). -->
                <Grid Grid.Column="2">
                    <!-- Nothing open: only a faint hint (empty when the library is empty, the list says that). -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                               Text="{Binding NoEditorText}"
                               Visibility="{Binding HasNoEditor, Converter={StaticResource BoolToVisibility}}" />

                    <Border x:Name="EditorCard" Margin="12" Padding="20,16" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270"
                                              Color="Black" Opacity="0.08" />
                        </Border.Effect>
                        <DockPanel LastChildFill="True">

                            <!-- Header row, top right: [Save when there are unsaved changes] Send to v, Copy prompt, the ... menu. -->
                            <Grid x:Name="ButtonRow" DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Save: only while dirty, with the Unsaved dot; fades in and out over 83 ms (Ctrl+S always works). -->
                                    <Button Style="{StaticResource SaveButton}" Margin="0,0,8,0"
                                            Command="{Binding SaveCommand}" IsEnabled="{Binding Editor.IsDirty}"
                                            Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,1,8,0" Fill="{DynamicResource Brush.Brand}" />
                                            <TextBlock Text="Save" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <Button Style="{StaticResource SubtleSplitLeft}" Content="Send to"
                                                Command="{Binding SendCommand}" IsEnabled="{Binding Editor.CanCopy}"
                                                ToolTip="{Binding SendDefaultName, StringFormat=Send to {0} (Ctrl+Shift+Enter)}"
                                                AutomationProperties.Name="Send to default AI app" />
                                        <Button x:Name="SendMenuButton" Style="{StaticResource SubtleSplitRight}" Content="&#xE70D;"
                                                Click="SendMenu_Click" IsEnabled="{Binding Editor.CanCopy}"
                                                ToolTip="Choose an AI app" AutomationProperties.Name="Choose an AI app" />
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" MinWidth="112"
                                            Content="{Binding Editor.CopyLabel}"
                                            Command="{Binding CopyCommand}" IsEnabled="{Binding Editor.CanCopy}"
                                            Margin="0,0,4,0"
                                            ToolTip="Copy prompt (Ctrl+Shift+C)" AutomationProperties.Name="Copy prompt" />
                                    <Button x:Name="OverflowButton" Style="{StaticResource SubtleButton}" Width="32" MinWidth="32"
                                            Padding="0" FontFamily="{StaticResource Font.Icons}" Content="&#xE712;" Click="Overflow_Click"
                                            ToolTip="More actions" AutomationProperties.Name="More actions">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource FlyoutMenu}">
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="{Binding PinLabel}"
                                                          Command="{Binding PinCommand}" IsEnabled="{Binding CanPin}" />
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="{Binding HideLabel}"
                                                          Command="{Binding HideCommand}"
                                                          Visibility="{Binding ShowTeamButtons, Converter={StaticResource BoolToVisibility}}" />
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="Make my copy"
                                                          Command="{Binding CopyToYoursCommand}"
                                                          Visibility="{Binding ShowTeamButtons, Converter={StaticResource BoolToVisibility}}" />
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="Version history…"
                                                          Command="{Binding ShowHistoryCommand}"
                                                          Visibility="{Binding CanShowHistory, Converter={StaticResource BoolToVisibility}}" />
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="Move to category"
                                                          ItemsSource="{Binding CategoryChoices}"
                                                          Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}">
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource FlyoutItem}">
                                                            <Setter Property="Header" Value="{Binding}" />
                                                            <Setter Property="HeaderTemplate" Value="{StaticResource CategoryNameTemplate}" />
                                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                                            <Setter Property="Command"
                                                                    Value="{Binding DataContext.MoveToCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                                <Separator Style="{StaticResource FlyoutSeparator}"
                                                           Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}" />
                                                <MenuItem Style="{StaticResource FlyoutItem}" Header="Delete prompt"
                                                          Foreground="{DynamicResource Brush.Danger}" Command="{Binding DeleteCommand}"
                                                          Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVisibility}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Under the card's body, always visible: when it was updated and how often it was used (quiet), the prompt's
                                 error, and the tab hint at the right (left out for a read-only prompt). -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <!-- Only while typing in the prompt box (Hidden, not Collapsed, so nothing moves). -->
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Tab inserts a tab" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptBox}" Value="True" />
                                                        <Condition Binding="{Binding Editor.IsReadOnly}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Editor.MetaText}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding Editor.TextError}" Style="{StaticResource ErrorText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Everything between the header and that line scrolls inside the card when the window is too small for it
                                 (at the minimum size, 200 % scaling): nothing is clipped. When there is room it is as tall as it needs. -->
                            <controls:FitScroll VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <controls:HeightGate>
                            <DockPanel LastChildFill="True">

                            <!-- Title and description are edited in place: flat fields, no labels (the automation names stay). -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <!-- A team prompt while the team library isn't being edited: one lock line, the fields
                                     below are normal, selectable text that can't be changed. -->
                                <DockPanel Margin="0,0,0,8">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LockLineText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource InlineGlyph}" Text="&#xE716;"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding LockLineText}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" AutomationProperties.Name="{Binding LockLineText}" />
                                </DockPanel>
                                <!-- Says this is a new, not yet saved prompt. -->
                                <TextBlock Text="New prompt" FontWeight="SemiBold" Margin="6,0,0,4"
                                           Visibility="{Binding Editor.IsNew, Converter={StaticResource BoolToVisibility}}" />
                                <!-- The title's error never moves anything: a Danger underline and the message inside the
                                     title's own row, at its right. -->
                                <Grid>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource InPlaceBox}" Tag="Untitled prompt"
                                             FontSize="18" FontWeight="SemiBold" MinHeight="36"
                                             Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding Editor.IsReadOnly}"
                                             AutomationProperties.Name="Title" />
                                    <Border Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="1"
                                            IsHitTestVisible="False" Background="{DynamicResource Brush.Danger}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Editor.TitleError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Editor.TitleError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding Editor.TitleError}" Style="{StaticResource ErrorText}"
                                               Margin="0,0,8,0" TextWrapping="NoWrap" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <TextBox x:Name="DescriptionBox" Style="{StaticResource InPlaceBox}" Tag="Add a description"
                                         Foreground="{DynamicResource Brush.Muted}"
                                         Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding Editor.IsReadOnly}"
                                         AutomationProperties.Name="Description" />
                            </StackPanel>

                            <!-- Category (compact) and tags (chips) on one row. -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox MinWidth="140" MaxWidth="220" VerticalAlignment="Top" Margin="0,0,8,0"
                                          ItemsSource="{Binding CategoryChoices}"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Editor.CategoryId}"
                                          Visibility="{Binding Editor.IsEditable, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="Category">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <emoji:EmojiImage Text="{Binding Emoji}" Margin="0,0,6,0">
                                                    <emoji:EmojiImage.Style>
                                                        <Style TargetType="emoji:EmojiImage">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Emoji}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </emoji:EmojiImage.Style>
                                                </emoji:EmojiImage>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!-- Read only: the category as plain text. -->
                                <TextBlock Text="{Binding EditorCategoryName}" Padding="6,7" Margin="0,0,8,0"
                                           AutomationProperties.Name="{Binding EditorCategoryName, StringFormat=Category {0}}"
                                           Visibility="{Binding Editor.IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                <controls:TagBox Grid.Column="1" Tags="{Binding Editor.Tags}"
                                                 IsReadOnly="{Binding Editor.IsReadOnly}" />
                                <!-- Never moves anything: laid over the row's right end. -->
                                <TextBlock Grid.Column="1" Text="{Binding Editor.CategoryError}" Style="{StaticResource ErrorText}"
                                           Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>

                            <!-- Prompt label, live count and the Edit | Preview switch (only when there is something to preview). -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                        CornerRadius="4" Padding="1" Background="{DynamicResource Brush.Surface}"
                                        Visibility="{Binding Editor.ShowViewToggle, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="PromptView" Content="Edit" Style="{StaticResource ViewSegment}"
                                                     IsChecked="{Binding Editor.IsEditMode, Mode=TwoWay}"
                                                     ToolTip="Edit the prompt" AutomationProperties.Name="Edit" />
                                        <RadioButton GroupName="PromptView" Content="Preview" Style="{StaticResource ViewSegment}"
                                                     IsChecked="{Binding Editor.IsPreview, Mode=TwoWay}"
                                                     ToolTip="See the prompt with its placeholders as chips"
                                                     AutomationProperties.Name="Preview" />
                                    </StackPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Editor.TextStats}" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="8,0,12,0" />
                                <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"
                                           MinHeight="24" />
                            </DockPanel>

                            <!-- The prompt slip: a page-toned inset with a 1 px Line frame and 8 px corners. It is as tall as its
                                 text (at least about eight lines) and takes the room left over only when the text is longer. -->
                            <controls:SlipFrame MinContentHeight="176" VerticalAlignment="Top">
                                <DockPanel>
                                    <Grid>
                                        <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="1" CornerRadius="8" />
                                        <controls:PromptTextEditor x:Name="PromptBox" Margin="4,2,2,2"
                                                 Text="{Binding Editor.Text, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding Editor.IsReadOnly}"
                                                 IsPreview="{Binding Editor.IsPreview}"
                                                 PlaceholderValues="{Binding PlaceholderValues}"
                                                 AutomationProperties.Name="Prompt text"
                                                 AutomationProperties.HelpText="Ctrl+Tab inserts a tab" />
                                        <Border BorderBrush="{DynamicResource Brush.Brand}" BorderThickness="2"
                                                CornerRadius="8" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptBox}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </controls:SlipFrame>
                            </DockPanel>
                            </controls:HeightGate>
                            </controls:FitScroll>
                        </DockPanel>
                    </Border>

                    <!-- Toast: "Copied", "Sent to ChatGPT", "Saved" (animated by MainWindow.ShowToast). -->
                    <Border x:Name="Toast" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="8" Height="40" Padding="16,0"
                            AutomationProperties.LiveSetting="Polite">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastSlide" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- The glyph follows the message: copy, save, send (MainWindow.ShowToast). -->
                            <TextBlock x:Name="ToastGlyph" Style="{StaticResource InlineGlyph}" FontSize="16" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.Brand}" Text="&#xE73E;" />
                            <TextBlock x:Name="ToastText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty library: one card centred across the whole content area (the list and editor columns, both ways).
                     While it shows, the list column drops its layer and its search row, so the area reads as one canvas; the
                     normal three-column layout is back as soon as the first prompt exists. -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="320" Padding="24,24" Margin="24"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding ShowNoPromptsYet, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EmptyGlyph}" Text="&#xE8F1;" HorizontalAlignment="Center" />
                        <TextBlock Text="Your library is empty" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,6,0,0"
                                   Text="Write your first prompt, or start with ready-made examples." />
                        <Button x:Name="EmptyNewPromptButton" Style="{StaticResource PrimaryButton}" Content="New prompt"
                                Command="{Binding NewPromptCommand}" Margin="0,16,0,0" Padding="8,0" MinWidth="0"
                                ToolTip="New prompt (Ctrl+N)" AutomationProperties.Name="New prompt" />
                        <Button Content="Add starter prompts" Command="{Binding AddStarterPromptsCommand}"
                                Margin="0,8,0,0" Padding="8,0" MinWidth="0"
                                ToolTip="Add 39 example prompts you can change or delete"
                                AutomationProperties.Name="Add starter prompts" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Declared last so it comes last in Tab order; shown at the top. -->
            <!-- Backups off / paused: a quiet 12 px bar with the link right after the sentence. -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Warn}" Padding="16,6"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                    ToolTip="{Binding BackupWarningDetail}"
                    Visibility="{Binding ShowBackupWarning, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel TextElement.FontSize="12">
                    <TextBlock Text="{Binding BackupWarning}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.WarnText}" Margin="0,0,8,0" />
                    <!-- "Set up backups" when they're off; "Check backups" when a chosen folder can't be reached. -->
                    <Button Command="{Binding SetUpBackupsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Content" Value="Check backups" />
                                <Setter Property="AutomationProperties.Name" Value="Check backups" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupWarningDetail}" Value="{x:Null}">
                                        <Setter Property="Content" Value="Set up backups" />
                                        <Setter Property="AutomationProperties.Name" Value="Set up backups" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
