<UserControl x:Class="PromptLibrary.App.Views.BackupLocationPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Backup location">
    <UserControl.Resources>
        <!-- A folder card is a button: provider name over the folder backups go to. The card in use has the
             list-selection look (BrandSoft fill, 3 px Brand left edge) plus "✓ In use". -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}" />
                            <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Background="{StaticResource Brush.Brand}"
                                    CornerRadius="4,0,0,4" Visibility="Collapsed" />
                            <Grid Margin="16,8,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FolderText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="InUse" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <Path Width="14" Height="14" Data="M1.5,7.5 L5.5,11.5 L12.5,3" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brush.Brand}" StrokeThickness="2" />
                                    <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                               Foreground="{StaticResource Brush.Brand}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="Busy" Grid.Column="1" Text="Backing up…" Style="{StaticResource MutedText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.Window}" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="InUse" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBackingUp}" Value="True">
                                <Setter TargetName="InUse" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.BrandSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenWhenNull" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Looking for cloud folders…" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Visibility="{Binding ShowDetecting, Converter={StaticResource BoolToVisibility}}" />

        <!-- Tab enters the list once; arrow keys move between cards; Enter, Space or a click backs up there
             (in the wizard it selects the card instead). -->
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" Focusable="False"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          AutomationProperties.Name="Backup folders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Folder}"
                                AutomationProperties.Name="{Binding AutomationName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="No cloud folder found. Sign in to OneDrive, Google Drive, Dropbox or iCloud and it will appear here, or choose any folder."
                   Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal">
            <Button x:Name="ChooseFolderButton" Content="Choose another folder…" Command="{Binding ChooseFolderCommand}"
                    ToolTip="Any local, USB or network folder" AutomationProperties.Name="Choose another folder" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                    Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Look for cloud folders again" AutomationProperties.Name="Refresh cloud folders" />
        </StackPanel>

        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HiddenWhenNull}" Margin="0,8,0,0" />

        <!-- ✓ in its own column so it stays beside the text when the text wraps; Try again after the text. -->
        <Grid Margin="0,8,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- ✓ before a success ("Backed up to OneDrive."), none before a failure. -->
            <Path Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" Data="M1.5,7.5 L5.5,11.5 L12.5,3"
                  Stroke="{StaticResource Brush.Brand}" StrokeThickness="2">
                <Path.Style>
                    <Style TargetType="Path">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
            <TextBlock Grid.Column="1" Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,0,8,0"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Try again" Command="{Binding TryAgainCommand}"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowTryAgain, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Try the backup again" />
        </Grid>
        <TextBlock Text="{Binding NoteText}" Style="{StaticResource HiddenWhenNull}" />
        <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource HiddenWhenNull}" />

        <Button Style="{StaticResource LinkButton}" Content="Restore from a backup…" HorizontalAlignment="Left"
                Margin="0,8,0,0" Command="{Binding RestoreCommand}" AutomationProperties.Name="Restore from a backup"
                Visibility="{Binding ShowRestoreLink, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
