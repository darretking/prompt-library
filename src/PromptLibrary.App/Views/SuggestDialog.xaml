<Window x:Class="PromptLibrary.App.Views.SuggestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Suggest for the team"
        AutomationProperties.Name="Suggest for the team"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- The prompt's title, a team category, an optional note with a count, your name; Send suggestion / Cancel. -->
    <StackPanel Margin="16">
        <TextBlock Text="{Binding PromptTitle}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding PromptTitle}" />
        <TextBlock Text="Sends this prompt to the team's editors. They decide whether to add it."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Text="Team category" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  AutomationProperties.Name="Team category" />

        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
        <TextBox x:Name="NoteBox" Style="{StaticResource {x:Type TextBox}}" Height="80" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 MaxLength="{Binding MaxNoteLength}"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Note (optional)" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Text="{Binding CountText}"
                   HorizontalAlignment="Right" />

        <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
        <TextBox Style="{StaticResource {x:Type TextBox}}" MaxLength="60"
                 Text="{Binding YourName, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Your name" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="Send suggestion" IsDefault="True"
                    Click="Send_Click" AutomationProperties.Name="Send suggestion" />
        </StackPanel>
    </StackPanel>
</Window>
