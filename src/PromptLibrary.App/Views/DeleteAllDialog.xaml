<Window x:Class="PromptLibrary.App.Views.DeleteAllDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Delete all your prompts?"
        AutomationProperties.Name="Delete all your prompts?"
        Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Settings → Delete all my prompts: what goes, what stays, and a typed DELETE so it never happens by accident.
         The Delete button stays disabled (and Enter does nothing) until the word is typed. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Team prompts are not affected. A safety copy is saved first, so Restore from backup can bring your prompts back." />

        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}">
            <Run Text="Type" /> <Run Text="DELETE" FontWeight="Bold" /> <Run Text="to confirm" />
        </TextBlock>
        <TextBox x:Name="ConfirmBox" AutomationProperties.Name="Type DELETE to confirm"
                 TextChanged="ConfirmBox_TextChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel" />
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="Delete all my prompts"
                    IsEnabled="False" IsDefault="True" Click="Delete_Click"
                    AutomationProperties.Name="Delete all my prompts" />
        </StackPanel>
    </StackPanel>
</Window>
