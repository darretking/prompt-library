<UserControl x:Class="PromptLibrary.App.Views.Controls.EmojiButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:PromptLibrary.App.Views.Controls"
             Focusable="False">
    <!-- A 32 px button showing the current emoji (a muted smiley when there is none); it opens a 6 x 6 grid of curated
         emoji and "No emoji". -->
    <UserControl.Resources>
        <Style x:Key="EmojiCell" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- "No emoji": a quiet text button under the grid, no fill until pointed at. -->
        <Style x:Key="NoEmojiButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="Trigger" Width="32" Height="32" MinWidth="32" Padding="0" Click="Trigger_Click"
                ToolTip="Choose an emoji" AutomationProperties.Name="Choose an emoji">
            <Grid>
                <emoji:EmojiImage x:Name="EmojiText" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="Smiley" Text="&#xE76E;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                           Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>

        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
               Opened="Picker_Opened">
            <Border Margin="0,4,8,8" Padding="8" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8"
                    PreviewKeyDown="Picker_PreviewKeyDown">
                <StackPanel KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl x:Name="Cells" AutomationProperties.Name="Emoji">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource EmojiCell}" Click="Cell_Click"
                                        AutomationProperties.Name="{Binding}">
                                    <Border Width="22" Height="22" Background="{DynamicResource Brush.EmojiTile}" BorderBrush="{DynamicResource Brush.EmojiTileRing}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius}">
                                        <emoji:EmojiImage Text="{Binding}" FontSize="15" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="No emoji" Style="{StaticResource NoEmojiButton}" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" Click="None_Click" AutomationProperties.Name="No emoji" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
