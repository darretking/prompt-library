<UserControl x:Class="PromptLibrary.App.Views.Controls.TagBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="Tags">
    <!-- A flat field: chips, then a typing box. The frame shows only on hover or focus (spec §10). -->
    <Border x:Name="Frame" BorderThickness="1" CornerRadius="4" MinHeight="32" Padding="2,0"
            Background="Transparent" SnapsToDevicePixels="True" MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ItemsControl x:Name="Chips" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.BrandSoft}" CornerRadius="4" Margin="2,2"
                                Padding="8,0,2,0" Height="24">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Brand}" />
                                <Button Click="RemoveChip_Click" Width="20" MinWidth="0" Height="20" Padding="0" Margin="2,0,0,0" Cursor="Hand"
                                        Visibility="{Binding RemoveVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Remove tag"
                                        AutomationProperties.Name="{Binding StringFormat=Remove tag {0}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Brand}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid x:Name="InputHost" MinWidth="88" VerticalAlignment="Center">
                <TextBlock x:Name="Placeholder" Text="Add tags" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False" />
                <TextBox x:Name="Input" Style="{x:Null}" BorderThickness="0" Foreground="{DynamicResource Brush.Ink}" CaretBrush="{DynamicResource Brush.Ink}" SelectionBrush="{DynamicResource Brush.BrandFill}" Background="Transparent" MinHeight="24" Padding="4,0"
                         VerticalContentAlignment="Center" MaxLength="40"
                         PreviewKeyDown="Input_PreviewKeyDown" PreviewTextInput="Input_PreviewTextInput"
                         TextChanged="Input_TextChanged" LostKeyboardFocus="Input_LostKeyboardFocus"
                         AutomationProperties.Name="Add tags" AutomationProperties.HelpText="Type a tag and press Enter or comma" />
            </Grid>
        </WrapPanel>
    </Border>
</UserControl>
