<Window x:Class="PromptLibrary.App.Views.TeamStartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Start a team library"
        AutomationProperties.Name="Start a team library"
        Icon="/Assets/app.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- Two fields (folder, name), an optional collapsed list of your categories to copy in, the business examples
         option, and Start. A folder that already has a team library offers Join it. -->
    <StackPanel Margin="16">
        <TextBlock Text="Shared folder" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Style="{StaticResource {x:Type TextBox}}"
                     Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEdit}"
                     AutomationProperties.Name="Shared folder"
                     AutomationProperties.HelpText="A folder your team can open, like one in OneDrive or Google Drive" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"
                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Browse for a folder" />
        </Grid>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource {x:Type TextBox}}"
                 Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanEdit}"
                 AutomationProperties.Name="Name" AutomationProperties.HelpText="What your team will see, like Acme best practice" />

        <Expander Header="Copy some of your categories in" Margin="0,12,0,0"
                  Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="Copy some of your categories in">
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,0,6"
                                  AutomationProperties.Name="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <CheckBox Content="Add example business prompts" IsChecked="{Binding AddBusinessExamples}" Margin="0,12,0,0"
                  IsEnabled="{Binding CanEdit}"
                  AutomationProperties.Name="Add example business prompts"
                  AutomationProperties.HelpText="24 ready-made prompts for sales, support, marketing, management, HR and operations. You can edit or delete any of them." />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                   Text="24 ready-made prompts in 6 categories. Edit or delete any of them." />

        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Working…" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,6,0,0"
                         Foreground="{DynamicResource Brush.Brand}" Background="{DynamicResource Brush.Line}"
                         BorderThickness="0" AutomationProperties.Name="Working" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Assertive" />
        <Button x:Name="JoinItButton" Style="{StaticResource LinkButton}" Content="Join it" HorizontalAlignment="Left"
                Margin="0,4,0,0" Command="{Binding JoinItCommand}" AutomationProperties.Name="Join it"
                Visibility="{Binding CanJoinExisting, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"
                    AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="Start" IsDefault="True"
                    Command="{Binding StartCommand}" AutomationProperties.Name="Start" />
        </StackPanel>
    </StackPanel>
</Window>
