<Window x:Class="PromptLibrary.App.Views.TeamFillInValuesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="Fill-in values for everyone"
        AutomationProperties.Name="Fill-in values for everyone"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- Field | Value rows: every field the team's prompts use, plus stored values. An empty value is not stored. -->
    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="Everyone starts with these values in matching fields. Leave a value empty for no team value." />
        <Grid Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Field" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
        </Grid>
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NameIsEditable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                     VerticalAlignment="Center" AutomationProperties.Name="Field name">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NameIsEditable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="{Binding Name, StringFormat='Value for {0}'}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Style="{StaticResource LinkButton}" Content="Add a field" HorizontalAlignment="Left"
                Margin="0,8,0,0" Click="AddField_Click" AutomationProperties.Name="Add a field" />

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="Save_Click"
                    AutomationProperties.Name="Save" />
        </StackPanel>
    </StackPanel>
</Window>
