<Window x:Class="PromptLibrary.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PromptLibrary.App.Views"
        Style="{StaticResource AppWindow}"
        Title="Settings"
        AutomationProperties.Name="Settings"
        Icon="/Assets/app.ico"
        Width="560" Height="720"
        ResizeMode="NoResize">
    <!-- Every setting applies as soon as it changes; Close (or Esc, or ×) just closes. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="16,16,16,24">

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource FieldLabel}" />
                <CheckBox x:Name="StartupBox" Content="Start Prompt Library when Windows starts"
                          AutomationProperties.Name="Start Prompt Library when Windows starts" />

                <!-- Backups -->
                <TextBlock Text="Backups" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                <views:BackupLocationPicker x:Name="Picker" />

                <!-- Only once backups go somewhere: there is nothing to keep while they are off. -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                            Visibility="{Binding DataContext.CanTurnOff, ElementName=Picker, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Keep the last" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeepBox" Width="80" Margin="8,0"
                              AutomationProperties.Name="Number of backups to keep" />
                    <TextBlock Text="backups" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Shortcut -->
                <TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                <StackPanel Orientation="Horizontal">
                    <views:ShortcutBox x:Name="ShortcutField" Style="{StaticResource {x:Type TextBox}}" Width="280"
                                       AutomationProperties.Name="Shortcut"
                                       AutomationProperties.HelpText="Press Enter or Change, then press the new shortcut" />
                    <Button Content="Change" Margin="8,0,0,0" Click="ChangeShortcut_Click"
                            AutomationProperties.Name="Change shortcut" />
                </StackPanel>
                <TextBlock x:Name="ShortcutStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- What the shortcut opens: each choice says what you get. -->
                <TextBlock Text="The shortcut opens" Margin="0,12,0,4" />
                <RadioButton x:Name="OpensSearchRadio" GroupName="ShortcutOpens" Content="The search window"
                             AutomationProperties.Name="Shortcut opens the search window" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="Type a few letters to find any prompt, see it before you paste it." />
                <RadioButton x:Name="OpensMenuRadio" GroupName="ShortcutOpens" Content="A menu at the mouse pointer" Margin="0,8,0,0"
                             AutomationProperties.Name="Shortcut opens a menu at the mouse pointer" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="Your categories and prompts as a short menu, no typing." />

                <!-- Pasting -->
                <TextBlock Text="Pasting" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                <CheckBox x:Name="PasteBox" Content="Paste into the app I was using"
                          AutomationProperties.Name="Paste into the app I was using"
                          AutomationProperties.HelpText="After you pick a prompt with the shortcut, it's pasted where you were typing. Turn off to only copy." />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="After you pick a prompt with the shortcut, it's pasted where you were typing. Turn off to only copy." />
                <CheckBox x:Name="RestoreBox" Margin="0,12,0,0" Content="Put back what was on the clipboard after pasting"
                          AutomationProperties.Name="Put back what was on the clipboard after pasting"
                          AutomationProperties.HelpText="After pasting, the text you had copied before comes back. Only plain text is put back." />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0"
                           Text="After pasting, the text you had copied before comes back. Only plain text is put back." />

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                <TextBlock Text="Theme" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystemRadio" GroupName="Theme" Content="System"
                                 AutomationProperties.Name="Theme: follow Windows" />
                    <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Content="Light" Margin="24,0,0,0"
                                 AutomationProperties.Name="Theme: light" />
                    <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Content="Dark" Margin="24,0,0,0"
                                 AutomationProperties.Name="Theme: dark" />
                </StackPanel>

                <!-- Team prompts: Join / Start until a team library is connected, then only the connected state + Leave. -->
                <StackPanel x:Name="TeamSection" Margin="0,24,0,0"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Team prompts" Style="{StaticResource FieldLabel}" />

                    <StackPanel Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Connect to your team's shared prompts, or start a library for your team." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Join a team library" Click="JoinTeam_Click"
                                    AutomationProperties.Name="Join a team library" />
                            <Button Content="Start a team library" Margin="8,0,0,0" Click="StartTeam_Click"
                                    AutomationProperties.Name="Start a team library" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConnectedLine}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <!-- "Updated today, 08:33", or why it can't be read right now + Retry. -->
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,0,8,0" AutomationProperties.Name="{Binding StatusText}" />
                            <Button Style="{StaticResource LinkButton}" Content="Retry" Command="{Binding RetryCommand}"
                                    ToolTip="Read the team library again" AutomationProperties.Name="Retry"
                                    Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <Button Content="Leave team library" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="LeaveTeam_Click" AutomationProperties.Name="Leave team library" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <!-- Nothing to apply: every change is saved the moment it is made. -->
                <TextBlock Text="Changes are saved as you make them." Style="{StaticResource MutedText}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Click="Close_Click"
                        AutomationProperties.Name="Close settings" />
            </Grid>
        </Border>
    </Grid>
</Window>
