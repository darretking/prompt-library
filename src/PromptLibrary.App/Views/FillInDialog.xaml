<Window x:Class="PromptLibrary.App.Views.FillInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PromptLibrary.App.Views"
        Style="{StaticResource AppDialog}"
        Title="Fill in the blanks"
        AutomationProperties.Name="Fill in the blanks"
        Icon="/Assets/app.ico"
        Width="560" Height="480" MinHeight="360"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- The main window's version of the search window's form: the same panel, with Cancel and Copy (or Send). -->
    <views:FillInPanel x:Name="Panel" />
</Window>
