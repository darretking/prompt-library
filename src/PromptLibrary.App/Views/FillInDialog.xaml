<Window x:Class="PromptLibrary.App.Views.FillInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PromptLibrary.App.Views"
        Style="{StaticResource AppDialog}"
        Title="Fill in the blanks"
        AutomationProperties.Name="Fill in the blanks"
        Icon="/Assets/app.ico"
        Width="560" SizeToContent="Height" MinHeight="240"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- The main window's version of the search window's form: the same panel, with Cancel and Copy (or Send). It is as tall as its form, up to 80 % of the work area (set in code), then the fields scroll. -->
    <views:FillInPanel x:Name="Panel" />
</Window>
