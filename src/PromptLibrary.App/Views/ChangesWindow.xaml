<Window x:Class="PromptLibrary.App.Views.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppDialog}"
        Title="What changed"
        AutomationProperties.Name="What changed"
        Icon="/Assets/app.ico"
        Width="560" Height="440" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DiffLineBorder" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Background" Value="{DynamicResource Brush.DiffAdded}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource Brush.DiffRemoved}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiffLineText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Prompt}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DiffAddedText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DiffRemovedText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Title, description or category: what it was, then what it is. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}" Focusable="False" Margin="0,0,0,8"
                      Visibility="{Binding HasFields, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Changed fields">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " />
                        <Run Text="{Binding Old, Mode=OneWay}" Foreground="{DynamicResource Brush.DiffRemovedText}" />
                        <Run Text=" → " Foreground="{DynamicResource Brush.Muted}" />
                        <Run Text="{Binding New, Mode=OneWay}" Foreground="{DynamicResource Brush.DiffAddedText}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}"
                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Changes in the text">
                <ItemsControl ItemsSource="{Binding Diff}" Margin="0,4" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DiffLineBorder}" Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Marker}" Style="{StaticResource DiffLineText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                               Style="{StaticResource DiffLineText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Margin="0,16,0,0" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                AutomationProperties.Name="Close" />
    </Grid>
</Window>
