<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light colour tokens. Same keys in Light.xaml and Dark.xaml; values documented in docs/design/ui-style.md. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Brush.Rail" Color="#ECEFF3" />
    <!-- Window and Rail areas that show the Mica backdrop. Opaque here; ThemeManager makes them translucent
         while Mica is active. -->
    <SolidColorBrush x:Key="Brush.WindowBackdrop" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Brush.RailBackdrop" Color="#ECEFF3" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#1B2230" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#5A6475" />
    <SolidColorBrush x:Key="Brush.Line" Color="#D6DBE3" />
    <!-- Brand: text, edges, links, focus ring. BrandFill: fills that carry white text (Copy button, ticked box). -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.BrandFill" Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.BrandSoft" Color="#E8E7FB" />
    <SolidColorBrush x:Key="Brush.BrandHover" Color="#3730A3" />
    <!-- Danger: text. DangerFill: the filled delete button with white text. -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#B42318" />
    <SolidColorBrush x:Key="Brush.DangerFill" Color="#B42318" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#912018" />
    <!-- Bookmark amber from the icon: onboarding illustration only, never text. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#F5A524" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFF4D6" />
    <SolidColorBrush x:Key="Brush.WarnText" Color="#6B4A00" />
    <!-- Text on a BrandFill or DangerFill. -->
    <SolidColorBrush x:Key="Brush.OnBrand" Color="#FFFFFF" />
    <!-- Fenced code blocks in the prompt editor; version-history diff rows (text colours checked at 4.5:1 on their fill). -->
    <SolidColorBrush x:Key="Brush.CodeBlock" Color="#F0F2F6" />
    <SolidColorBrush x:Key="Brush.DiffAdded" Color="#E3F4E8" />
    <SolidColorBrush x:Key="Brush.DiffAddedText" Color="#14532D" />
    <SolidColorBrush x:Key="Brush.DiffRemoved" Color="#FCE8E6" />
    <SolidColorBrush x:Key="Brush.DiffRemovedText" Color="#8A1C14" />
</ResourceDictionary>
