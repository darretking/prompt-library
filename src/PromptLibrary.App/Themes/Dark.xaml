<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark colour tokens. Same keys as Light.xaml; values documented in docs/design/ui-style.md. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.Rail" Color="#161920" />
    <!-- Window and Rail areas that show the Mica backdrop. Opaque here; ThemeManager makes them translucent
         while Mica is active. -->
    <SolidColorBrush x:Key="Brush.WindowBackdrop" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.RailBackdrop" Color="#161920" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#242833" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#E8EAF0" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#A0A8B8" />
    <SolidColorBrush x:Key="Brush.Line" Color="#353B48" />
    <!-- Brand: text, edges, links, focus ring. BrandFill: fills that carry white text (Copy button, ticked box). -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#8B85F0" />
    <SolidColorBrush x:Key="Brush.BrandFill" Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.BrandSoft" Color="#2E2D52" />
    <SolidColorBrush x:Key="Brush.BrandHover" Color="#3730A3" />
    <!-- Danger: text. DangerFill: the filled delete button with white text. -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.DangerFill" Color="#B42318" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#912018" />
    <!-- Bookmark amber from the icon: onboarding illustration only, never text. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#F5A524" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#3A2F12" />
    <SolidColorBrush x:Key="Brush.WarnText" Color="#F5D48A" />
    <!-- Text on a BrandFill or DangerFill. -->
    <SolidColorBrush x:Key="Brush.OnBrand" Color="#FFFFFF" />
</ResourceDictionary>
