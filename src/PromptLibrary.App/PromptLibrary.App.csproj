<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>PromptLibrary.App</RootNamespace>
    <!-- The exe is PromptLibrary.exe. Windows shows the file description (AssemblyTitle) as the app name in
         notifications of an unpackaged app, so these say "Prompt Library". No AppUserModelID is set in code:
         without a matching Start-menu shortcut Windows would show the raw ID instead. -->
    <AssemblyName>PromptLibrary</AssemblyName>
    <AssemblyTitle>Prompt Library</AssemblyTitle>
    <Product>Prompt Library</Product>
    <Company>Prompt Library</Company>
    <!-- The installer takes its version from this exe's file version; bump it for every release. -->
    <Version>1.2.1</Version>
    <Copyright>Copyright © 2026 Darret King. Licensed under GPL-3.0-or-later.</Copyright>
    <!-- The GitHub repository whose releases the update checker asks about. A fork changes these two lines;
         leaving either empty turns the checker off. -->
    <UpdateRepositoryOwner>darretking</UpdateRepositoryOwner>
    <UpdateRepositoryName>prompt-library</UpdateRepositoryName>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepositoryOwner</_Parameter1>
      <_Parameter2>$(UpdateRepositoryOwner)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepositoryName</_Parameter1>
      <_Parameter2>$(UpdateRepositoryName)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="PromptLibrary.App.Tests" />
  </ItemGroup>

  <!-- Runtime settings for a tray app that mostly sits idle: workstation, non-concurrent GC (no background GC thread, a
       smaller heap), no PGO instrumentation (less JIT memory), and a GC that prefers a compact heap. -->
  <PropertyGroup>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- Single-file, self-contained publish (dotnet publish -c Release). Release only, so Debug builds and
       `dotnet run` keep the normal framework-dependent layout. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- WPF and WinForms share type names (Application, Clipboard, MessageBox...). Keep WPF as the
       default and write WinForms/System.Drawing types fully qualified (only the tray uses them). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as a WPF resource so the tray and window icons work from a single-file publish. -->
    <Resource Include="Assets\app.ico" />
    <!-- The onboarding wizard's welcome illustration. -->
    <Resource Include="Assets\app-icon.png" />
    <!-- Bundled Microsoft Fluent Emoji colour images (MIT), drawn by EmojiImage. -->
    <Resource Include="Assets\Emoji\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PromptLibrary.Core\PromptLibrary.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
